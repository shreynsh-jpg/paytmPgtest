# Copy this file to .env and fill in values from the Paytm Business dashboard
# (Developer Settings -> API Keys). Never commit .env.

# Leave PAYTM_MID empty to run in MOCK mode (no real Paytm calls).
PAYTM_MID=
PAYTM_MERCHANT_KEY=

# STAGING for testing, PRODUCTION for live payments
PAYTM_ENV=STAGING

# Usually WEBSTAGING on staging and DEFAULT on production
PAYTM_WEBSITE=WEBSTAGING
PAYTM_INDUSTRY_TYPE_ID=Retail
PAYTM_CHANNEL_ID=WEB
PAYTM_CLIENT_ID=C11

# Paytm Native Subscription mandate mode (UPI must be enabled for this MID)
PAYTM_SUBSCRIPTION_PAYMENT_MODE=UPI

# Public base URL of this server. Paytm posts the payment result to
# {BASE_URL}/payment/callback, so in production this must be your real https domain.
BASE_URL=http://localhost:5000

# Shown on the checkout page
MERCHANT_NAME=My Store

# Optional: override the gateway address (defaults to Paytm's paytmpayments.com hosts)
# PAYTM_HOST=https://securestage.paytmpayments.com

# How long an auto-debit mandate stays valid, in years (subscriptions only)
SUBSCRIPTION_YEARS=5
TRIAL_DAYS=7

# Random secret for the daily /cron/sync job
CRON_SECRET=
